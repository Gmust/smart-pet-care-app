{
  "expo": {
    "name": "smart-pet-care-app",
    "slug": "miso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartpetcareapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/05b59c80-0998-45de-8dcf-fc5af0872ae5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.smart-pet-care-app",
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.smartpetcareapp",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F2",
          "dark": {
            "backgroundColor": "#FAF8F2"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-build-properties",
      [
        "react-native-edge-to-edge",
        { "android": { "parentTheme": "Default", "enforceNavigationBarContrast": false } }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to upload pictures",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2d5e4e",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/dog.wav",
            "./assets/sounds/cat.wav",
            "./assets/sounds/bird.wav",
            "./assets/sounds/guinea_pig.wav",
            "./assets/sounds/fish.wav"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44433327-239b-4f93-9693-f527c5f7a0ae"
      }
    },
    "owner": "reflexivecdvs-team"
  }
}
